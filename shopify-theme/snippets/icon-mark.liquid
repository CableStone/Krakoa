  <line x1="54.5" y1="37" x2="54.5" y2="63" stroke="currentColor" stroke-width="2.5"/>
  <line x1="37" y1="43.5" x2="63" y2="43.5" stroke="currentColor" stroke-width="2.5"/>
  <line x1="37" y1="50" x2="63" y2="50" stroke="currentColor" stroke-width="2.5"/>
