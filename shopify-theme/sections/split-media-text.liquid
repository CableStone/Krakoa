{%- liquid
  assign copy_class = 'split-copy'
  if section.settings.copy_style == 'panel'
    assign copy_class = copy_class | append: ' panel-bg'
  endif
  assign copy_style = ''
  if section.settings.copy_style == 'indigo'
    assign copy_style = 'background:var(--indigo);color:var(--cream)'
  endif
-%}
<section class="split">
  {%- if section.settings.image_position == 'right' -%}
    <div class="{{ copy_class }}" {% if copy_style != '' %}style="{{ copy_style }}"{% endif %}>
      {% render 'split-media-text-copy', section: section, on_indigo: section.settings.copy_style == 'indigo' %}
    </div>
    <div class="split-photo">
      {% render 'media-or-placeholder', image: section.settings.image, caption: section.settings.placeholder_caption, sizes: '50vw' %}
    </div>
  {%- else -%}
    <div class="split-photo">
      {% render 'media-or-placeholder', image: section.settings.image, caption: section.settings.placeholder_caption, sizes: '50vw' %}
    </div>
    <div class="{{ copy_class }}" {% if copy_style != '' %}style="{{ copy_style }}"{% endif %}>
      {% render 'split-media-text-copy', section: section, on_indigo: section.settings.copy_style == 'indigo' %}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Split — media & text",
  "settings": [
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "select", "id": "copy_style", "label": "Text panel style", "options": [{ "value": "plain", "label": "Plain background" }, { "value": "panel", "label": "Panel background" }, { "value": "indigo", "label": "Indigo background" }], "default": "plain" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "placeholder_caption", "label": "Placeholder caption" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Twelve stones. Nine hands." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link_url", "label": "Link URL" }
  ],
  "presets": [{ "name": "Split — media & text" }]
}
{% endschema %}
