<section class="contact-intro">
  {%- if section.settings.eyebrow != blank -%}<div class="contact-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
  <h1 class="serif contact-title">{{ section.settings.heading }}</h1>
</section>

<div class="contact-grid">
  <div>
    <h2 class="serif">{{ section.settings.form_heading }}</h2>
    {%- form 'contact', id: 'ContactForm' -%}
      <div class="contact-form">
        <div class="field">
          <label for="ContactForm-name">Name</label>
          <input type="text" id="ContactForm-name" name="contact[name]" required
                 value="{% if form.name %}{{ form.name }}{% endif %}">
        </div>
        <div class="field">
          <label for="ContactForm-email">Email</label>
          <input type="email" id="ContactForm-email" name="contact[email]" required
                 value="{% if form.email %}{{ form.email }}{% endif %}">
        </div>
        <div class="field">
          <label for="ContactForm-subject">Subject</label>
          <select id="ContactForm-subject" name="contact[Subject]">
            <option>General Inquiry</option>
            <option>Order Support</option>
            <option>Press &amp; Wholesale</option>
            <option>Careers</option>
          </select>
        </div>
        <div class="field">
          <label for="ContactForm-message">Message</label>
          <textarea id="ContactForm-message" name="contact[body]" rows="5" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
        </div>
        <button type="submit" class="btn-solid-indigo">Send Message</button>
        <div class="form-note{% if form.errors %} form-note--error{% endif %}">
          {%- if form.posted_successfully? -%}
            Thank you — we'll be in touch shortly.
          {%- elsif form.errors -%}
            {%- for field in form.errors -%}{{ form.errors.messages[field] }}. {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    {%- endform -%}
  </div>

  <div class="info-list">
    {%- for block in section.blocks -%}
      <div class="info-block" {{ block.shopify_attributes }}>
        <div class="info-label">{{ block.settings.label }}</div>
        <div class="info-value">{{ block.settings.value }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a Message" }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info block",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Atelier & Showroom" },
        { "type": "richtext", "id": "value", "label": "Value", "default": "<p>14 Rue de Saintonge<br>75003 Paris, France</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact form",
      "blocks": [
        { "type": "info", "settings": { "label": "Atelier & Showroom", "value": "<p>14 Rue de Saintonge<br>75003 Paris, France</p>" } },
        { "type": "info", "settings": { "label": "Hours", "value": "<p>Tuesday – Saturday<br>11:00 – 19:00, by appointment</p>" } },
        { "type": "info", "settings": { "label": "Client Care", "value": "<p>hello@lyonsofjudah.com<br>+33 1 42 00 00 00</p>" } },
        { "type": "info", "settings": { "label": "Follow", "value": "<p><a href=\"#\">Instagram</a> · <a href=\"#\">Pinterest</a></p>" } }
      ]
    }
  ]
}
{% endschema %}
