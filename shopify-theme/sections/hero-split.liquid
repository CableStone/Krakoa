<section class="hero">
  <div class="hero-photo">
    {% render 'media-or-placeholder', image: section.settings.image, caption: section.settings.placeholder_caption, sizes: '(min-width: 900px) 55vw, 100vw' %}
  </div>
  <div class="hero-copy">
    {%- if section.settings.eyebrow != blank -%}<div class="hero-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1 class="serif hero-title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_url }}" class="btn-solid">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero (split)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "placeholder_caption", "label": "Placeholder caption", "default": "Hero — model in flagship look" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No. 01 — Tzadik Him" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The faces, worn close." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Hand-drawn portraits of the tzadikim on heavyweight cotton." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Collection" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero (split)" }]
}
{% endschema %}
