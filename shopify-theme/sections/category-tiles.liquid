<section class="category-tiles">
  {%- for block in section.blocks -%}
    <a class="ph category-tile" href="{{ block.settings.link }}" {{ block.shopify_attributes }}
       {% if block.settings.image %}style="padding:0;border:none;background:none"{% endif %}>
      {%- if block.settings.image -%}
        <div class="media-fill">
          {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 900px) 33vw, 100vw', alt: block.settings.label }}
        </div>
      {%- else -%}
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
      {%- endif -%}
      <div class="ph-cap" {% if block.settings.image %}style="position:absolute;bottom:16px;left:16px;right:16px;text-align:left;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.4);max-width:none"{% endif %}>{{ block.settings.label }}</div>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Category tiles",
  "settings": [],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Choshen — the twelve stones" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile", "settings": { "label": "Choshen — the twelve stones" } },
        { "type": "tile", "settings": { "label": "Tzadik Him — the portraits" } },
        { "type": "tile", "settings": { "label": "Everyday — tees & knits" } }
      ]
    }
  ]
}
{% endschema %}
